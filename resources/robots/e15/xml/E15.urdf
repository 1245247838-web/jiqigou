<?xml version='1.0' encoding='UTF-8'?>
<robot name="E15_strict_CAD_aligned">
  <mujoco>
  <compiler meshdir="../meshes" discardvisual="false"/>
  </mujoco>
  <!-- Collision primitives replaced from /home/user/quad48 on 2026-07-23; visuals, joints, masses, COMs and inertias are unchanged. -->
  <!-- Strictly aligned to E15V1&#19996;&#39118;URDF-20260714.docx and the supplied local-coordinate CAD STL files on 2026-07-17. -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.9137254901960784 0.9137254901960784 0.8470588235294118 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4235294117647059 0.0392156862745098 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.8705882352941177 0.8117647058823529 0.7647058823529411 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="payload_dark">
    <color rgba="0.05 0.06 0.065 0.85"/>
  </material>
  <!-- SolidWorks inertia tensors use the set reported as: about the center of mass and aligned with Coordinate System 1. -->
  <link name="world"/>
  <joint name="floating_base_joint" type="floating">
      <parent link="world"/>
      <child link="trunk"/>
  </joint>
  <link name="trunk">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/e15_trunk_with_radar.STL" scale="1 1 1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!--Collision primitive copied from quad48; detailed E15 CAD remains visual-only.-->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.342 0.22 0.11"/>
        <!-- <box size="0.301 0.2 0.11"/> -->
      </geometry>
    </collision>
    <collision name="front_narrow_vertical_plate_collision">
      <origin rpy="0 0 0" xyz="0.3 0 0.01"/>
      <geometry>
        <box size="0.018 0.115 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.007453 0.002493 0.005813"/>
      <mass value="8.155032"/>
      <inertia ixx="0.033809207" ixy="0.001824472" ixz="-0.010200345" iyy="0.161449800" iyz="0.000173116" izz="0.174466658"/>
    </inertial>
  </link>
  <!-- Visual meshes and supplied mass properties are CAD-aligned. Collision primitives remain simplified for simulation stability. -->
  <!-- Imu is fixed to the base link -->
  <joint name="imu_link_joint" type="fixed">
    <origin rpy="0. 0. 0." xyz="0. 0. 0."/>
    <parent link="trunk"/>
    <child link="imu_link"/>
  </joint>
  <!-- Imu link -->
  <link name="imu_link">
    <!-- Massless coordinate frame: the physical IMU is already included in the supplied assembly mass. -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.004"/>
      </geometry>
      <material name="orange">
        <color rgba="255 108 10 255"/>
      </material>
    </visual>
  </link>
  <gazebo reference="imu_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <joint name="FR_hip_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.229200 -0.050000 0"/>
    <parent link="trunk"/>
    <child link="FR_hip"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="48" lower="-0.6108652381980153" upper="0.6108652381980153" velocity="18.4"/>
  </joint>
  <link name="FR_hip">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/e15_FR_hip.STL" scale="1 1 1"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.003296 -0.003877 -0.000426"/>
      <mass value="0.984205"/>
      <inertia ixx="0.000762" ixy="0.000032" ixz="0.000021" iyy="0.001383" iyz="-0.000007" izz="0.000951"/>
    </inertial>
  </link>
  <joint name="FR_thigh_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.110050 0"/>
    <parent link="FR_hip"/>
    <child link="FR_thigh"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="48" lower="-3.6651914291880923" upper="0.5235987755982988" velocity="18.4"/>
  </joint>
  <link name="FR_thigh">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/e15_FR_thigh.STL" scale="1 1 1"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <!-- The proximal cylinder is merged into the thigh collision, so the side-swing hip carries no separate collider. -->
    <collision>
      <origin rpy="0 1.5707963267948966 0" xyz="-0.017 0 -0.13"/>
      <geometry>
        <box size="0.14 0.0245 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0.045 0"/>
      <geometry>
        <cylinder length="0.126667" radius="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.002604 0.027090 -0.022630"/>
      <mass value="1.485935"/>
      <inertia ixx="0.006399" ixy="-0.000121" ixz="-0.000346" iyy="0.006318" iyz="-0.000938" izz="0.001657"/>
    </inertial>
  </link>
  <joint name="FR_calf_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.220230"/>
    <parent link="FR_thigh"/>
    <child link="FR_calf"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="48" lower="0.7853981633974483" upper="2.7925268031909272" velocity="18.4"/>
  </joint>
  <link name="FR_calf">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/e15_FR_calf.STL" scale="1 1 1"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <!-- Shortened calf collision, tilted 5 degrees from vertical. -->
    <collision>
      <origin rpy="0 1.4835298641951802 0" xyz="-0.01 0 -0.099619"/>
      <geometry>
        <box size="0.200 0.016 0.016"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Contact-fix: 0.020000 kg is split from the CAD calf assembly into the foot body. Calf+foot aggregate mass, COM and inertia remain equal to the original CAD calf assembly. -->
      <origin rpy="0 0 0" xyz="0.0 -0.000045191 -0.101256351"/>
      <mass value="0.195677"/>
      <inertia ixx="0.00165630335" ixy="-0.00000001182" ixz="0.00023249878" iyy="0.00169653135" iyz="0.00000089500" izz="0.00006002793"/>
    </inertial>
  </link>
  <joint name="FR_foot_fixed" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0 0 -0.229300"/>
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
  </joint>
  <link name="FR_foot">
